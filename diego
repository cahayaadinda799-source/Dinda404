<!DOCTYPE html>
<html>
<head>
    <title>diego</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: #1a1423;
            color: #e2d1ff;
            font-family: 'Segoe UI', monospace;
            padding: 20px;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            background: #2a1e35;
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 0 20px rgba(200, 160, 255, 0.3);
            animation: muncul 1s ease;
        }
        @keyframes muncul {
            0% {
                opacity: 0;
                transform: translateY(30px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }
        h1 {
            font-size: 50px;
            text-align: center;
            color: #ffb3c6;
            text-shadow: 2px 2px 0 #b8a0ff;
            margin-bottom: 20px;
            animation: goyang 3s infinite;
        }
        @keyframes goyang {
            0%,100% { transform: rotate(0deg); }
            25% { transform: rotate(1deg); }
            75% { transform: rotate(-1deg); }
        }
        .foto {
            width: 130px;
            height: 130px;
            background: #ffd1e6;
            border-radius: 50%;
            margin: 20px auto;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 70px;
            color: #2a1e35;
            border: 4px solid #b8a0ff;
            animation: masuk 1.5s;
        }
        @keyframes masuk {
            0% { transform: scale(0); }
            80% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }
        .bio {
            background: #33253f;
            padding: 20px;
            border-radius: 15px;
            margin: 20px 0;
            border-left: 6px solid #ffb3c6;
            animation: geser 1.2s;
        }
        @keyframes geser {
            0% { transform: translateX(-50px); opacity: 0; }
            100% { transform: translateX(0); opacity: 1; }
        }
        .bio p {
            margin: 8px 0;
            font-size: 18px;
        }
        .menu {
            display: flex;
            gap: 10px;
            margin: 20px 0;
            flex-wrap: wrap;
        }
        .menu a {
            color: #e2d1ff;
            text-decoration: none;
            background: #3d2d4d;
            padding: 10px 20px;
            border-radius: 30px;
            transition: 0.3s;
            flex: 1;
            text-align: center;
            border: 1px solid #b8a0ff;
            animation: naik 1.4s;
        }
        @keyframes naik {
            0% { transform: translateY(30px); opacity: 0; }
            100% { transform: translateY(0); opacity: 1; }
        }
        .menu a:hover {
            background: #ffb3c6;
            color: #1a1423;
            transform: scale(1.05);
            border-color: #ffb3c6;
        }
        h2 {
            color: #ffb3c6;
            margin: 25px 0 15px 0;
            border-bottom: 2px dashed #b8a0ff;
            padding-bottom: 5px;
            animation: muncul 1.6s;
        }
        .kotak {
            background: #33253f;
            padding: 15px;
            border-radius: 12px;
            margin: 10px 0;
            border: 1px solid #b8a0ff;
            animation: muncullist 1.8s;
        }
        @keyframes muncullist {
            0% { opacity: 0; transform: scale(0.9); }
            100% { opacity: 1; transform: scale(1); }
        }
        .bar {
            height: 8px;
            background: #4a3a57;
            border-radius: 10px;
            margin-top: 8px;
            overflow: hidden;
        }
        .bar-isi {
            height: 8px;
            background: linear-gradient(90deg, #ffb3c6, #b8a0ff);
            border-radius: 10px;
            width: 0%;
            animation: isi 2s forwards;
        }
        @keyframes isi {
            from { width: 0%; }
            to { width: var(--w); }
        }
        .kontak {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #33253f;
            padding: 12px;
            border-radius: 10px;
            margin: 8px 0;
            transition: 0.3s;
            animation: muncullist 2s;
        }
        .kontak:hover {
            background: #4a3a57;
            transform: translateX(5px);
        }
        .footer {
            text-align: center;
            margin-top: 30px;
            padding-top: 20px;
            border-top: 2px solid #b8a0ff;
            color: #b8a0ff;
            animation: muncul 2.2s;
        }
    </style>
</head>
<body>

<div class="container">
    <h1>diego</h1>
    
    <div class="foto">
        😎
    </div>
    
    <div class="bio">
        <p>⚡ nama : diego</p>
        <p>📌 umur : 19</p>
        <p>💫 dari : jakarta</p>
        <p>🎯 hobi : ngoding + dengerin musik</p>
    </div>
    
    <div class="menu">
        <a href="#">beranda</a>
        <a href="#">project</a>
        <a href="#">tentang</a>
    </div>
    
    <h2>⚡ skill</h2>
    
    <div class="kotak">
        <div style="display: flex; justify-content: space-between;">
            <span>html/css</span> <span>70%</span>
        </div>
        <div class="bar"><div class="bar-isi" style="--w:70%"></div></div>
    </div>
    
    <div class="kotak">
        <div style="display: flex; justify-content: space-between;">
            <span>python</span> <span>60%</span>
        </div>
        <div class="bar"><div class="bar-isi" style="--w:60%"></div></div>
    </div>
    
    <div class="kotak">
        <div style="display: flex; justify-content: space-between;">
            <span>javascript</span> <span>45%</span>
        </div>
        <div class="bar"><div class="bar-isi" style="--w:45%"></div></div>
    </div>
    
    <h2>📁 project</h2>
    
    <div class="kotak">
        <b>› bot termux</b> - script python buat termux
    </div>
    <div class="kotak">
        <b>› web ini</b> - belajar html css dikit
    </div>
    <div class="kotak">
        <b>› tools random</b> - kumpulan script iseng
    </div>
    
    <h2>📞 kontak</h2>
    
    <div class="kontak">
        <span>📱</span> @diego_aja
    </div>
    <div class="kontak">
        <span>📧</span> diego@email.com
    </div>
    <div class="kontak">
        <span>🐦</span> @diego_aja
    </div>
    
    <div class="footer">
        dibuat sendiri pake html doang · 2025
    </div>
</div>

</body>
</html>